# =============================================================
# KALKS website - environment overview
# The website reads apps/trader/.env.local (copy the block below).
# =============================================================

# ---- apps/trader/.env.local (website, port 3010) ----
# NEXT_PUBLIC_BRAND_NAME=KALKS
# NEXT_PUBLIC_BRAND_SLUG=kalks
# NEXT_PUBLIC_BRAND_DOMAIN=kalks.com
# NEXT_PUBLIC_BRAND_SUPPORT_EMAIL=support@kalks.com
# Kalks Client Area: every "Log in" / "Sign up" / "Open account" goes here
# NEXT_PUBLIC_CRM_URL=http://localhost:3000
