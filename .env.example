# =============================================================
# KALKS website - environment overview
# The website reads apps/trader/.env.local in development (copy the block below).
# Production public values are committed in apps/trader/.env.production; secrets go in
# apps/trader/.env.production.local on the server (deploy/deploy-website.sh in the Kalks repo writes them).
# =============================================================

# ---- apps/trader/.env.local (website) ----
# NEXT_PUBLIC_BRAND_NAME=Kalks
# NEXT_PUBLIC_BRAND_DOMAIN=kalkstrade.com
# NEXT_PUBLIC_SITE_URL=https://kalkstrade.com
# NEXT_PUBLIC_BRAND_SUPPORT_EMAIL=support@kalkstrade.com
# Kalks Client Area: every "Log in" / "Sign up" / "Open account" goes here (default https://app.kalkstrade.com)
# NEXT_PUBLIC_CRM_URL=https://app.kalkstrade.com
# Kalks Trader (default https://trade.kalkstrade.com)
# NEXT_PUBLIC_TRADER_URL=https://trade.kalkstrade.com
# Public market data: live prices on /markets and /options (default https://api.kalkstrade.com)
# NEXT_PUBLIC_MARKET_API=https://api.kalkstrade.com

# Server-side only (never NEXT_PUBLIC): the platform's news service, for the homepage market-news ticker.
# Without them the ticker shows a link to the economic calendar instead.
# NEWS_URL=http://127.0.0.1:8103
# NEWS_INTERNAL_TOKEN=<same value as NEWS_INTERNAL_TOKEN in the Kalks repo's .env.local>
