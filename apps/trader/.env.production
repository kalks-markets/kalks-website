# Public brand values for production builds.
#
# NEXT_PUBLIC_* variables are inlined into the browser bundle at BUILD time, so they must be present when
# `next build` runs. None of these are secrets, so they live in the repo. A .env.local on the server overrides them.
NEXT_PUBLIC_BRAND_NAME=Kalks
NEXT_PUBLIC_BRAND_DOMAIN=kalkstrade.com
NEXT_PUBLIC_SITE_URL=https://kalkstrade.com
NEXT_PUBLIC_BRAND_SUPPORT_EMAIL=support@kalkstrade.com
# Hand-offs: Kalks Client Area (sign-in, sign-up, every signed-in page), Kalks Trader, public market data
NEXT_PUBLIC_CRM_URL=https://app.kalkstrade.com
NEXT_PUBLIC_TRADER_URL=https://trade.kalkstrade.com
NEXT_PUBLIC_MARKET_API=https://api.kalkstrade.com
