# =============================================================
# Kalks website (apps/trader): copy to .env.local for local development.
# See ../../.env.example for what each value does.
# =============================================================

# Brand and canonical URL (production values are committed in .env.production)
# NEXT_PUBLIC_BRAND_NAME=Kalks
# NEXT_PUBLIC_BRAND_DOMAIN=kalkstrade.com
# NEXT_PUBLIC_SITE_URL=https://kalkstrade.com
# NEXT_PUBLIC_BRAND_SUPPORT_EMAIL=support@kalkstrade.com

# Hand-offs and public market data
# NEXT_PUBLIC_CRM_URL=https://app.kalkstrade.com
# NEXT_PUBLIC_TRADER_URL=https://trade.kalkstrade.com
# NEXT_PUBLIC_MARKET_API=https://api.kalkstrade.com

# Server-side only: the platform's news service (homepage market-news ticker)
# NEWS_URL=http://127.0.0.1:8103
# NEWS_INTERNAL_TOKEN=
